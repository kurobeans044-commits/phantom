yui,winten,Lacki,Gemes,Wimmy1,grtyui,Frandl,kees1,mokers,Obings,treedom,romberty,Skings,Disney1,line,inger1,eness1,Action,E12332,76543,Enjamilt,231234567,asdf1,starwarr,sierry,oloradle,Comeri,agord1,ilorevor,ucatin,ashanie,8765432,nicherry,Rariah,mrocky1,Nemes1,Vateur,hris1,snakis,Rarinit,rinerso,etroopy,Gel1,St12345,Lairem,onica1,lookies,456789,Atcatd,itherome,Ang1,Yler,canaki,ancentus,anicorv,junick,Stein2,Ockitty,Pme,Bottie,Antheryl,Catinald,mein2,iterso,shelle,Texan,fetten,no1,dolpha1,Orty12,Torittl,kardva,compala,Ivatashl,Olasta,Driah,Tans,Scarta,skippl,ticky1,Immie,redmaxim,Ness1,Edwars,gatern,dennon,arshang,undann,Lorschen,Sychocol,cooky,iloria,Iley,ichael1,windon,hley,Aragon1,Phendam,Rubba1,lission"

   
    // build combined sample list from all tables
    allSamples = []
    for tableKey in tables.indexes
        for pw in tables[tableKey].split(",")
            if pw.len > order then allSamples.push(pw)
        end for
    end for
	gco.seedWords = allSamples   // raw dictionary words, pre-branching — for ar's dictionary attack
    // build markov chains from all samples
    chains = {}
    for sample in allSamples
        for i in range(0, sample.len - order - 1)
            key = sample[i : i + order]
            if not chains.hasIndex(key) then chains[key] = []
            nextChar = sample[i + order]
            if chains[key].indexOf(nextChar) == null then chains[key].push(nextChar)
        end for
    end for

    // collect start configs — use maxLength as ceiling instead of seed length
    configMap = {}
    for sample in allSamples
        for startPos in range(0, sample.len - order)
            key = sample[startPos : startPos + order]
            // 5hell-style: grow only up to the seed's OWN length (capped by maxLength for safety)
            targetLen = sample.len
            if targetLen > maxLength then targetLen = maxLength
            configKey = key + "|" + targetLen
            if not configMap.hasIndex(configKey) then
                configMap[configKey] = [key, targetLen]
            end if
        end for
    end for

    passwordSet = {}

    allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    cleanPw = function(pw)
        for i in range(0, pw.len - 1)
            if allowed.indexOf(pw[i]) == null then return ""
        end for
        return pw
    end function

    // capitalize first letter
    Cap = function(s)
        if s.len == 0 then return s
        return s[:1].upper + s[1:]
    end function

    // 5hell's leading consonant-cluster strip: if the first two letters
    // form an unpronounceable cluster, drop the first letter so the word
    // looks like a game-generated password (e.g. Bverontro -> Verontro)
    Reshape = function(s)
        if s.len < 2 then return s
        a = s[0]
        b = s[1]
        if a.lower == b or ("hrl'aeiou".indexOf(b) == null and "AEIOUS".indexOf(a) == null and (a + b) != "Ch" and (a + b) != "Mc") then
            rest = s[1:]
            if rest.len == 0 then return rest
            return rest[:1].upper + rest[1:]
        end if
        return s
    end function

    // seed with all originals
    for tableKey in tables.indexes
        for pw in tables[tableKey].split(",")
            pl = cleanPw(pw.lower)
            if pl != "" then
                passwordSet[pl] = 1
                if pl.len > 0 then passwordSet[pl[:1].upper + pl[1:]] = 1
            end if
        end for
    end for

    // iterative markov branching
    totalConfigs = configMap.indexes.len
    configsDone  = 0
    lastReport   = 0
    print(c.grey + "  walking " + totalConfigs + " chain configs  (order=" + order + " min=" + minLength + " max=" + maxLength + ")..." + c.ennd)
    for configKey in configMap.indexes
        config = configMap[configKey]
        startKey = config[0]
        targetLen = config[1]
        if targetLen < minLength then continue
        stack = [[startKey, targetLen]]
        while stack.len > 0
            item = stack.pop
            current = item[0]
            target = item[1]
            if current.len >= target then
                fp = cleanPw(current.lower)
                while fp.len > 0 and (fp[0] == "-")
                    fp = fp[1:]
                end while
                while fp.len > 0 and (fp[-1] == "-")
                    fp = fp[:-1]
                end while
                if fp.len >= minLength then
                    passwordSet[fp] = 1
                    if fp.len > 0 then passwordSet[fp[:1].upper + fp[1:]] = 1
                end if
                continue
            end if
            token = current[current.len - order:]
            if not chains.hasIndex(token) then
                fp = cleanPw(current.lower)
                if fp.len >= minLength then
                    passwordSet[fp] = 1
                    if fp.len > 0 then passwordSet[fp[:1].upper + fp[1:]] = 1
                end if
                continue
            end if
            if current.len >= minLength then
                fp = cleanPw(current.lower)
                if fp != "" then
                    passwordSet[fp] = 1
                    if fp.len > 0 then passwordSet[fp[:1].upper + fp[1:]] = 1
                end if
            end if
            for nextChar in chains[token]
                stack.push([current + nextChar, target])
            end for
        end while
        configsDone = configsDone + 1
        pct = floor(configsDone / totalConfigs * 100)
        if pct >= lastReport + 10 then
            lastReport = pct
            print(c.grey + "  " + pct + "%  " + passwordSet.len + " passwords so far..." + c.ennd)
        end if
    end for

    // 5hell-style post-process: add the consonant-strip reshaped form of
    // every word, plus 3/4-char prefix/suffix fragments — the game's real
    // passwords are largely these short truncations, so without them the
    // table never matches them (this is the key difference from before)
    baseWords = passwordSet.indexes
    for w in baseWords
        if w.len < 2 then continue
        rs = Reshape(Cap(w))
        if rs != "" then
            passwordSet[rs] = 1
            passwordSet[rs.lower] = 1
        end if
        if w.len > 3 then
            f4 = w[:4]
            f3 = w[:3]
            passwordSet[f4] = 1
            passwordSet[Cap(f4)] = 1
            passwordSet[f3] = 1
            passwordSet[Cap(f3)] = 1
        end if
        if w.len > 4 then
            b3 = w[-3:]
            b4 = w[-4:]
            passwordSet[b3] = 1
            passwordSet[Cap(b3)] = 1
            passwordSet[b4] = 1
            passwordSet[Cap(b4)] = 1
        end if
    end for

    return passwordSet.indexes
end function
CommandTable["mark"] = @MarkovGenerate
// -- Rainbow Table ------------------------------------------------
buildRainbowTable = function(orderArg, minLenArg, maxLenArg)
    gco.rt = {}
    print(c.green + "Generating passwords via Markov chain..." + c.ennd)
    passwords = MarkovGenerate(orderArg, minLenArg, maxLenArg)
    print(c.orange + "Hashing " + passwords.len + " passwords..." + c.ennd)
    hashDone    = 0
    hashTotal   = passwords.len
    hashReport  = 0
    for pw in passwords
        gco.rt[md5(pw)] = pw
        hashDone = hashDone + 1
        hashPct = floor(hashDone / hashTotal * 100)
        if hashPct >= hashReport + 25 then
            hashReport = hashPct
            print(c.grey + "  hashing " + hashPct + "%  (" + hashDone + "/" + hashTotal + ")" + c.ennd)
        end if
    end for
    // import any .txt or .lst wordlist files from phantom folder
    localComp = myComp
    if not localComp then localComp = get_shell.host_computer
    dir = localComp.File(currentPath)
    loaded = 0
    if dir and dir.is_folder then
        files = dir.get_files
        for f in files
            nl = f.name.lower
            if nl.len >= 4 and (nl[-4:] == ".txt" or nl[-4:] == ".lst" or nl[-4:] == " ") then
                content = f.get_content
                if content then
                    lines = content.split(char(10))
                    for line in lines
                        pw = line.split(" ")[0]
                        if pw != "" then gco.rt[md5(pw)] = pw
                    end for
                    loaded = loaded + 1
                    print(c.grey + "  imported: " + f.name + c.ennd)
                end if
            end if
        end for
    end if
    print(c.green + "Rainbow table ready: " + gco.rt.len + " entries  (" + loaded + " wordlist(s) imported)" + c.ennd)
end function

RTGen = function(orderArg, minLenArg, maxLenArg)
    buildRainbowTable(orderArg, minLenArg, maxLenArg)
    print(c.orange + "Writing " + gco.rt.len + " entries to disk..." + c.ennd)
    rtPath = "/root/ai/tp"
    rtDir = myComp.File(rtPath)
    keys = gco.rt.indexes
    total = keys.len
    count = 0
    output = ""
    i = 0
    while i < total
        hash = keys[i]
        output = output + gco.rt[hash] + ":" + hash + char(10)
        if output.len > 159000 or i == total - 1 then
            num = "00" + count
            filename = "rt." + num[-3:] + ".rt"
            myComp.touch(rtPath, filename)
            f = myComp.File(rtPath + "/" + filename)
            if f then
                f.set_content(output)
                count = count + 1
            end if
            output = ""
        end if
        i = i + 1
    end while
    print(c.green + "rtgen: wrote " + count + " file(s) to " + rtPath + c.ennd)
    print(c.green + "rtgen: " + gco.rt.len + " total entries" + c.ennd)
end function

// ── RtLearn ──────────────────────────────────────────────────────
// Called whenever CrackHash cracks a hash the rainbow table didn't
// already have (i.e. via gco.crypto.decipher, the slow official
// cracker) — memoizes it into gco.rt for instant reuse this session,
// AND appends it to a plain wordlist file in currentPath so
// buildRainbowTable's own wordlist-import step (it already scans
// every .txt/.lst file there — see the "import any .txt or .lst
// wordlist" loop above) picks it back up on the next buildrt/rtgen
// run, even though that wipes gco.rt clean first. This is what turns
// every crack into a permanent addition to the password db instead of
// a one-off lookup that's forgotten the moment gco.rt regenerates.
// -- LearnPassword --------------------------------------------------
// Appends a plaintext password to learned.txt (dedup'd), so
// buildRainbowTable's wordlist-import step picks it up on the next
// buildrt/rtgen run. Split out of RtLearn so anything that discovers
// a working plaintext password — not just CrackHash's hash->pw path —
// can feed it back into the permanent word list (see ChainSaw.recurse
// / ChainSaw.PregenAttack in chainsaw.src).
LearnPassword = function(pw)
    if not pw or pw == "" then return
    learnedPath = currentPath + "/learned.txt"
    f = myComp.File(learnedPath)
    if not f then
        myComp.touch(currentPath, "learned.txt")
        f = myComp.File(learnedPath)
    end if
    if not f then return

    existing = f.get_content
    if not existing or existing == null then existing = ""
    if existing.split(char(10)).indexOf(pw) != null then return
    f.set_content(existing + pw + char(10))
end function

RtLearn = function(hash, pw)
    if not pw or pw == "" then return
    if not gco.hasIndex("rt") or gco.rt == null then gco.rt = {}
    gco.rt[hash] = pw
    LearnPassword(pw)
end function


rtDebug = function(inp)
gcoT = get_custom_object
if gcoT.hasIndex("rt") then
	print(c.rust + " current rt.len = " + gcoT.rt.len)
	else
	print(c.red + " no rainbows :(")
end if

// -- RTGen - write rainbow table to disk --------------------------

CrackHash = function(hash)
    if not gco.hasIndex("rt") or gco.rt == null then buildRainbowTable
    if gco.rt.hasIndex(hash) then return gco.rt[hash]
    if gco.crypto then
        pw = gco.crypto.decipher(hash)
        if pw then RtLearn(hash, pw)
        return pw
    end if
    return null
end function


end function
CommandTable["rtlen"] = @rtDebug


CmdBuildrt = function(inp)
    // buildrt [order] [minLen] [maxLen]
    // defaults: order=3 min=3 max=12  →  ~48k passwords
    // example:  buildrt 2 3 14        →  ~200k+ passwords
    oA = null
    mnA = null
    mxA = null
    if inp.len >= 2 then oA  = inp[1].to_int
    if inp.len >= 3 then mnA = inp[2].to_int
    if inp.len >= 4 then mxA = inp[3].to_int
    gco.rt = null
    buildRainbowTable(oA, mnA, mxA)
end function
CommandTable["buildrt"] = @CmdBuildrt

MarkovGenerate = function(orderArg, minLenArg, maxLenArg)
    order     = 3   // 5hell uses order-3 chains
    minLength = 5
    maxLength = 12  // safety cap only — generation length is bounded by each seed's OWN length (5hell-style)
    if typeof(orderArg)  == "number" then order     = orderArg
    if typeof(minLenArg) == "number" then minLength = minLenArg
    if typeof(maxLenArg) == "number" then maxLength = maxLenArg

    // multiple themed sample lists for more variety
    tables = {}


ShowHelp = function(flag)
    if flag == "-a" or flag == "-l" then
        print(char(10) + c.lime + "<b>-- LOCAL ----------------------------------------------------" + c.ennd + char(10))
        print(c.yellow+"<b>ls</b>"+c.ennd+"         ls [opt:-l -a] [opt:path]")
        print(c.yellow+"<b>tree</b>"+c.ennd+"       tree [opt:path]  (visual file tree)")
        print(c.yellow+"<b>cd</b>"+c.ennd+"         cd [path]  /  cd ..")
        print(c.yellow+"<b>cat</b>"+c.ennd+"        cat [file]")
        print(c.yellow+"<b>cp</b>"+c.ennd+"         cp [src] [dst]")
        print(c.yellow+"<b>mv</b>"+c.ennd+"         mv [src] [dst]")
        print(c.yellow+"<b>rm</b>"+c.ennd+"         rm [opt:-r] [path]")
        print(c.yellow+"<b>mkdir</b>"+c.ennd+"      mkdir [path]")
        print(c.yellow+"<b>touch</b>"+c.ennd+"      touch [path/file]")
        print(c.yellow+"<b>chmod</b>"+c.ennd+"      chmod [opt:-R] [perms] [path]")
        print(c.yellow+"<b>chown</b>"+c.ennd+"      chown [opt:-R] [owner] [path]")
        print(c.yellow+"<b>chgrp</b>"+c.ennd+"      chgrp [opt:-R] [group] [path]")
        print(c.yellow+"<b>search</b>"+c.ennd+"     search [opt:keyword]")
        print(c.yellow+"<b>ps</b>"+c.ennd+"         ps")
        print(c.yellow+"<b>kill</b>"+c.ennd+"       kill [PID]")
        print(c.yellow+"<b>passwd</b>"+c.ennd+"     passwd [user]")
        print(c.yellow+"<b>useradd</b>"+c.ennd+"    useradd [user]")
        print(c.yellow+"<b>userdel</b>"+c.ennd+"    userdel [opt:-r] [user]")
        print(c.yellow+"<b>pwd</b>"+c.ennd+"        pwd")
        print(c.yellow+"<b>whoami</b>"+c.ennd+"     whoami")
        print(c.yellow+"<b>clear</b>"+c.ennd+"      clear")
        print(c.yellow+"<b>decipher</b>"+c.ennd+"   decipher [-h user:hash] [-f /path]")
        print(c.yellow+"<b>cover</b>"+c.ennd+"      cover  (corlog + wipe + drop shell)")
        print(c.yellow+"<b>corlog</b>"+c.ennd+"     corrupt system.log on current object")
        print(c.yellow+"<b>escalate</b>"+c.ennd+"   escalate local privileges via lib scan")
        print(c.yellow+"<b>push</b>"+c.ennd+"       push current object onto stack")
        print(c.yellow+"<b>pop</b>"+c.ennd+"        pop object from stack -> set as active")
        print(c.yellow+"<b>stack</b>"+c.ennd+"      show all stacked objects")
        print(c.yellow+"<b>swap</b>"+c.ennd+"       swap [opt:index]  (swap active with stack entry)")
        print(c.yellow+"<b>drop</b>"+c.ennd+"       drop [-l] [-r]")
        print(c.yellow+"<b>terminal</b>"+c.ennd+"   open new local terminal")
        print(c.yellow+"<b>randip</b>"+c.ennd+"     generate a random IP")
    end if
    if flag == "-a" or flag == "-n" then
        print(char(10) + c.lime + "<b>-- NETWORK --------------------------------------------------" + c.ennd + char(10))
        print(c.yellow+"<b>nmap</b>"+c.ennd+"       nmap [ip/pt/lt] [-y]  (-y: auto-confirm setting it as target, no prompt)")
        print(c.yellow+"<b>ping</b>"+c.ennd+"       ping [ip/pt/lt/bt]")
        print(c.yellow+"<b>whois</b>"+c.ennd+"      whois [public ip]")
        print(c.yellow+"<b>ifconfig</b>"+c.ennd+"   ifconfig")
        print(c.yellow+"<b>set</b>"+c.ennd+"        set [ip] [opt:-b]")
        print(c.yellow+"<b>unset</b>"+c.ennd+"      unset [-p] [-l] [-b] [-a]")
        print(c.yellow+"<b>ssh</b>"+c.ennd+"        ssh [user@pass] [ip] [opt:port]  |  ssh [saved-name]")
        print(c.yellow+"<b>sshsave</b>"+c.ennd+"    sshsave [name] [user@pass] [ip] [opt:port]  (save your own login for quick reconnect)")
        print(c.yellow+"<b>sshlist</b>"+c.ennd+"    sshlist  (show saved portals)")
        print(c.yellow+"<b>sshdel</b>"+c.ennd+"     sshdel [name]  (remove a saved portal)")
        print(c.yellow+"<b>scp</b>"+c.ennd+"        scp [-u|-d] [src] [dst]")
        print(c.yellow+"<b>routerdata</b>"+c.ennd+"  routerdata [ip] [opt:port]")
        print(c.yellow+"<b>proxy</b>"+c.ennd+"      proxy [hops]  (build anonymous chain)")
        print(c.yellow+"<b>proxystatus</b>"+c.ennd+"  show current proxy chain")
        print(c.yellow+"<b>proxyclear</b>"+c.ennd+"   clear chain + drop object")
    end if
    if flag == "-a" or flag == "-h" then
        print(char(10) + c.lime + "<b>-- HACKING --------------------------------------------------" + c.ennd + char(10))
        print(c.yellow+"<b>edb</b>"+c.ennd+"        edb  |  edb use/search/add/del/clear  (exploit database)")
        print(c.yellow+"<b>scan</b>"+c.ennd+"       scan [ip] [port] [lan-ip] -lib [lib.so] [opt:mem] [opt:val]")
        print(c.yellow+"<b>scanlan</b>"+c.ennd+"    scanlan [ip] [port] [opt:-c] [opt:-l]  (direct ip: recon only, caches for grab; LAN ip: auto-pivots + attempts)")
        print(c.grey+"              -l: scan locally instead of via a held remote shell (e.g. after jump)"+c.ennd)
        print(c.yellow+"<b>grab</b>"+c.ennd+"       grab [ip] [port] [mem] [val] [opt:inject]")
        print(c.yellow+"<b>exploit</b>"+c.ennd+"    exploit [ip] [port] [opt:-c]  (interactive: pick a candidate + inject value, direct ips only)")
		print(c.yellow+"<b>qg</b>"+c.ennd+"         qg [ip] [port] (quick grab a shell)")
        print(c.yellow+"<b>getroot</b>"+c.ennd+"    getroot [path] [password]")
        print(c.yellow+"<b>autoroot</b>"+c.ennd+"   autoroot  |  autoroot [ip] [user] [pass]  |  autoroot -l [user]  (crack local password via ChainSaw)")
		print(c.grey + char(9) + "<b>ar                       -> escalate to root using Dictionary Attack (remote); ar -l [user] for local" + c.ennd)
        print(c.yellow+"<b>enum</b>"+c.ennd+"       enum [-l] [-r]  (full filesystem dump)")
        print(c.yellow+"<b>harvest</b>"+c.ennd+"    harvest  (crack Mail.txt + Bank.txt)")
        print(c.yellow+"<b>wifi</b>"+c.ennd+"       wifi  (scan + crack nearby WiFi networks)")
        print(c.yellow+"<b>siphon</b>"+c.ennd+"     siphon [opt:-a/-b/-m/-p/-l/-n]  (network-wide harvest)")
        print(c.yellow+"<b>wstack</b>"+c.ennd+"     wstack [opt:-l] [opt:libname]  (bounce LAN, push ROOT computers to stack)")
        print(c.yellow+"<b>wstackall</b>"+c.ennd+"  wstackall [opt:-l] [opt:libname]  (same as wstack, but also keeps guest-level shell/computer bounces)")
        print(c.grey+"              no -l: uploads + launches on the held shell so you don't have to jump first"+c.ennd)
        print(c.grey+"              (confirmed: LAN visibility from outside a network is much more limited than"+c.ennd)
        print(c.grey+"              from a script running inside it, so this isn't just convenience)"+c.ennd)
        print(c.grey+"              -l: run inline instead (like uselib) — you must already be positioned here"+c.ennd)
        print(c.grey+"              no libname given: uses globals.activeLib if one's claimed/loaded, else"+c.ennd)
        print(c.grey+"              defaults to init.so, falling back to libhttp.so if missing"+c.ennd)
        print(c.grey+"              whatever lib actually gets used lands in globals.activeLib too (like scanlib)"+c.ennd)
        print(c.grey+"              tries every candidate per device — only a root-level computer counts as a"+c.ennd)
        print(c.grey+"              hit, a guest-only bounce is discarded instead of settled for"+c.ennd)
        print(c.yellow+"<b>cascade</b>"+c.ennd+"    cascade  (wstack from every shell on stack simultaneously)")
        print(c.yellow+"<b>lanenum</b>"+c.ennd+"    lanenum [opt:-l] [opt:@var]  (list LAN IPs, clip to @var)")
        print(c.grey+"              -l: enumerate locally instead of via a held remote shell (e.g. after jump)"+c.ennd)
        print(c.yellow+"<b>ipenum</b>"+c.ennd+"     ipenum [port] [opt:@var]  (find LAN IPs with port open, clip to @var)")
        print(c.yellow+"<b>foreach</b>"+c.ennd+"    foreach @list | cmd @each ...  (run pipeline per item)")
        print(c.yellow+"<b>mac</b>"+c.ennd+"        mac <name>  |  mac list  |  mac show <name>  (run macro from /root/ai/mac/)")
        print(c.yellow+"<b>pwnlan</b>"+c.ennd+"     pwnlan  (exploit all LAN devices)")
        print(c.yellow+"<b>netmap</b>"+c.ennd+"     netmap [opt:-l]  (LAN recon only, no attacking — fast; scanlan/grab a target after)")
        print(c.grey+"              -l: map locally instead of via a held remote shell/computer (e.g. after jump)"+c.ennd)
        print(c.yellow+"<b>hacklan</b>"+c.ennd+"    hacklan [lan-ip]  (bounce to LAN device)")
        print(c.yellow+"<b>autoharvest</b>"+c.ennd+"  autoharvest [hops] [max_targets]")
        print(c.yellow+"<b>buildrt</b>"+c.ennd+"    build rainbow table in memory")
        print(c.yellow+"<b>rtgen</b>"+c.ennd+"      rtgen  (build + write rainbow table to ~/rt/)")
        print(c.yellow+"<b>crack</b>"+c.ennd+"      crack [hash]")
        print(c.yellow+"<b>jump</b>"+c.ennd+"       jump [opt:--rshell] [opt:-b|--bin] [opt:--loadlib name]  (copy phantom to target)")
        print(c.grey+"              -b/--bin: copy just the phantom binary, not the whole tp folder — if that flag"+c.ennd)
        print(c.grey+"              misbehaves, jumpbin does the same thing with no flag parsing at all"+c.ennd)
        print(c.grey+"              --loadlib name: target auto-loads that lib from ITS OWN /lib and exits"+c.ennd)
        print(c.grey+"              immediately, no interactive prompt — chain with |> uselib ... for a full"+c.ennd)
        print(c.grey+"              jump+load-remote-lib+bring-home+attack in one command. implies -b/--bin"+c.ennd)
        print(c.yellow+"<b>jumpbin</b>"+c.ennd+"    jumpbin [opt:--loadlib name]  (dedicated bin-only jump, no flags — see jump -b above)")
        print(c.yellow+"<b>leave</b>"+c.ennd+"      leave  |  leave -lib [name] [opt:port]  (leave held shell/computer, or a lib name, for another phantom session to claim)")
        print(c.grey+"              -lib auto-captures the held shell's ip if you're holding one, so claim can redial +"+c.ennd)
        print(c.grey+"              dump_lib on the far end if the lib isn't sitting in /lib there as an actual file"+c.ennd)
        print(c.yellow+"<b>claim</b>"+c.ennd+"      claim  (pick up whatever leave left — shell/computer lands in object, a lib gets loaded fresh into globals.activeLib)")
        print(c.yellow+"<b>carry</b>"+c.ennd+"      carry  |  carry -home  |  carry -c  (snapshot held shell into gco.object, or THIS machine into gco.homeShell, for any script/jump to read back; -c clears both)")
        print(c.yellow+"<b>loadlib</b>"+c.ennd+"    loadlib [name]  |  loadlib -c  (load a local lib straight into globals.activeLib, or clear it)")
        print(c.yellow+"<b>loadmx</b>"+c.ennd+"     loadmx [opt:path]  |  loadmx -c  (load a local metaxploit.so into globals.activeMx, or clear it)")
        print(c.grey+"              run before jump/jumpbin so uselib scans with YOUR metaxploit on the far end"+c.ennd)
        print(c.yellow+"<b>libvers</b>"+c.ennd+"    libvers  (list every lib in this machine's own /lib with its version)")
        print(c.yellow+"<b>uselib</b>"+c.ennd+"     uselib [opt:inject] [opt:-l lanip] [opt:-a|-sh|-c] [opt:-s]  (scan/exploit with globals.activeLib)")
        print(c.grey+"              -a: push every shell+computer   -sh: shells only   -c: computers only   (dedupes stack)"+c.ennd)
        print(c.grey+"              -s: recon only, record candidates to db.txt without attacking"+c.ennd)
        print(c.grey+"              -c: computer-ONLY — without it, only a shell counts as a hit; with it,"+c.ennd)
        print(c.grey+"                  only a computer does (a shell result gets rejected, not accepted too)."+c.ennd)
        print(c.grey+"                  implies -a: tries every candidate, pushes every computer found"+c.ennd)
        print(c.grey+"              -s: recon only, banks candidates to db.txt without calling overflow()"+c.ennd)
        print(c.grey+"              -l lanip: bounce onto a LAN device (same as a bare positional inject arg)"+c.ennd)
        print(c.grey+"              -a: try every candidate, push every match found to the stack (still"+c.ennd)
        print(c.grey+"                  shells-only unless -c is also given)"+c.ennd)
        print(c.grey+"                  (default stops at the first hit, lands it in globals.object)"+c.ennd)
        print(c.yellow+"<b>activelib</b>"+c.ennd+"  activelib  (debug: show what's held in globals.activeLib)")
        print(c.yellow+"<b>libdebug</b>"+c.ennd+"   libdebug [opt:-c]  (debug: show/clear gco.claimLib)")
        print(c.yellow+"<b>plant</b>"+c.ennd+"      plant [opt:lib] [opt:dest]  (upload lib from /root/InsecureLibs)")
        print(c.yellow+"<b>rshell</b>"+c.ennd+"     rshell  |  rshell start/stop/init/infect/info")
    end if
    if flag == "-a" or flag == "-r" then
        print(char(10) + c.lime + "<b>-- REMOTE ---------------------------------------------------" + c.ennd + char(10))
        print(c.yellow+"<b>rls</b>"+c.ennd+"        rls [opt:path]")
        print(c.yellow+"<b>rtree</b>"+c.ennd+"      rtree [opt:path]  (visual file tree on remote)")
        print(c.yellow+"<b>rcd</b>"+c.ennd+"        rcd [path]")
        print(c.yellow+"<b>rcat</b>"+c.ennd+"       rcat [file]")
        print(c.yellow+"<b>rcp rmv rrm</b>"+c.ennd+"  rcp/rmv/rrm [opt:-r] [src] [dst]")
        print(c.yellow+"<b>rmkdir rtouch</b>"+c.ennd+"  rmkdir/rtouch [path]")
        print(c.yellow+"<b>rchmod rchown rchgrp</b>"+c.ennd+"  [opt:-R] [val] [path]")
        print(c.yellow+"<b>rsearch</b>"+c.ennd+"    rsearch [opt:keyword]")
        print(c.yellow+"<b>rps</b>"+c.ennd+"        show remote processes")
        print(c.yellow+"<b>rkill</b>"+c.ennd+"      rkill [PID]")
        print(c.yellow+"<b>rpasswd</b>"+c.ennd+"    rpasswd [user]")
        print(c.yellow+"<b>ruseradd ruserdel</b>"+c.ennd+"  ruseradd/ruserdel [opt:-r] [user]")
        print(c.yellow+"<b>rcorlog</b>"+c.ennd+"    rcorlog [-y]  (corrupt remote system.log; -y auto-confirms, no prompt)")
        print(c.yellow+"<b>rterminal</b>"+c.ennd+"  open terminal on remote machine")
        print(c.yellow+"<b>rwhoami</b>"+c.ennd+"    current user on held remote shell")
        print(c.yellow+"<b>rdecipher</b>"+c.ennd+"  rdecipher [-h user:hash] [-f /path]")
        print(c.grey+"  all remote commands work on held remote object" + c.ennd)
    end if
    if flag == "" or flag == null then
        print(char(10) + c.cyan + "<b>PHANTOM v1.2" + c.ennd + c.grey + "  by operator" + c.ennd)
        print(c.grey + "help [-a] all   [-l] local   [-n] network   [-h] hacking   [-r] remote" + c.ennd)
        print(char(10) + c.gold + "quick ref:" + c.ennd)
        print(c.grey + "  proxy [hops]        -> build anonymous chain first" + c.ennd)
        print(c.grey + "  scan pt 0           -> find router exploits" + c.ennd)
        print(c.grey + "  grab pt 0 [m] [v]   -> get router shell" + c.ennd)
        print(c.grey + "  autoroot            -> escalate to root using ChainSaw" + c.ennd)
		print(c.grey + "  wifi             	  -> manage/connect wifi" + c.ennd)
        print(c.grey + "  upgrade             -> check local lib updates (upgrade -u to install)" + c.ennd)
		print(c.grey + "  apt-add             -> add-repo" + c.ennd)
		print(c.grey + "  apt-update          -> check local lib updates" + c.ennd)
		print(c.grey + "  apt-install         -> Install Something [like metaxploit.so]" + c.ennd)
		print(c.grey + "  apt-del             -> delete repo from apt-get" + c.ennd)
        print(c.grey + "  plant               -> put weaklib into remote /lib" + c.ennd)
        print(c.grey + "  scan pt 0 [lanip] -lib libhttp.so  -> bounce to LAN device" + c.ennd)
        print(c.grey + "  jump --rshell       -> set up rshell server on target" + c.ennd)
        print(c.grey + "  push/pop/stack/swap -> juggle multiple objects" + c.ennd)
        print(c.grey + "  cover               -> clean up traces" + c.ennd)
    end if
end function

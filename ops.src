CmdScan = function(inp)
    if inp.len == 3 and inp[1] == "-l" then
        Scan("-l", inp[2], myComp, null, null)
    else if inp.len == 4 and inp[1] == "-l" then
        Scan("-l", inp[2], myComp, inp[3], null)
    else if inp.len == 3 then
        Scan(inp[1], inp[2], myComp, null, null)
    else if inp.len == 4 then
        Scan(inp[1], inp[2], myComp, inp[3], null)
    else if inp.len == 6 and inp[4] == "-lib" then
        // no mem/val given — ScanRemoteLib used to default these to
        // "0x1F000FB5"/"length" (init.so's specific known-weak pair),
        // silently trying that against WHATEVER lib you named, which
        // only ever worked by coincidence. inp[1]/inp[2] (ip/port) were
        // also never actually used inside ScanRemoteLib — it always
        // operated on the currently held `object` regardless. LibScan
        // (scanlib's own implementation) already does exactly what
        // this needs — checks db.txt-known exploits for the named
        // lib+version first, falls back to a real scan/decode if none
        // exist — so delegate to that instead of duplicating it here.
        LibScan(inp[5], inp[3], false)
    else if inp.len == 8 and inp[4] == "-lib" then
        // explicit mem/val given — a deliberate manual override (e.g.
        // you already know the working pair from a scanlib/grab run
        // elsewhere), not something that needs auto-detection
        ScanRemoteLib(inp[1], inp[2], inp[3], inp[5], inp[6], inp[7])
    else
        print("<b>Usage: scan [ip] [port]")
        print(c.grey + "  LAN IPs are detected automatically when holding a shell" + c.ennd)
        print(c.grey + "  scan -l [lib]              scan local lib" + c.ennd)
        print(c.grey + "  scan [ip] [port] [lanip] -lib [lib.so]  remote lib scan — checks db.txt-known exploits first, full scan/decode fallback" + c.ennd)
        print(c.grey + "  scan [ip] [port] [lanip] -lib [lib.so] [mem] [val]  same, but force this exact mem/val instead of auto-detecting" + c.ennd)
    end if
end function
CommandTable["scan"] = @CmdScan


// metaxploit-free port scan — uses get_router().used_ports instead of
// net_use, so it works when metaxploit.so isn't loaded. PUBLIC ips only
// (get_router needs a routable address); recon only, no exploit session.
// portFilter: list of port strings to limit to, or [] for all open.
PortsRouter = function(targets, portFilter)
    openIps = []
    lastOpen = ""
    for tgt in targets
        if tgt == "" then continue
        r = get_router(tgt)
        if not r then
            print(c.grey + "  [-] " + tgt + " — no router (LAN ip or unreachable)" + c.ennd)
            continue
        end if
        ups = r.used_ports
        if not ups or ups.len == 0 then
            print(c.grey + "  [-] " + tgt + " — no open ports" + c.ennd)
            continue
        end if
        found = []
        for p in ups
            pn = "" + p.port_number
            if portFilter.len > 0 and portFilter.indexOf(pn) == null then continue
            if p.is_closed then continue
            print(c.lime + "  [+] " + tgt + "  " + pn + " open  (lan " + p.get_lan_ip + ")" + c.ennd)
            found.push(pn)
            lastOpen = pn
        end for
        if found.len > 0 then openIps.push(tgt)
    end for
    if openIps.len > 0 then
        globals.pipeResult = openIps.join(",")
        globals.pipeVars["port"] = lastOpen
        print(c.cyan + "ports: " + openIps.len + "/" + targets.len + " ip(s) with an open port — " + openIps.join(", ") + c.ennd)
    else
        globals.pipeFailed = true
        print(c.yellow + "<b>ports: no open ports found" + c.ennd)
    end if
end function

CmdGrab = function(inp)
    autoPush       = inp.indexOf("-push") != null
    acceptComputer = inp.indexOf("-c")   != null
    args = []
    for a in inp[1:]
        if a != "-push" and a != "-c" then args.push(a)
    end for
    if args.len == 2 then
        Grab(args[0], args[1], null, null, null, acceptComputer)
    else if args.len == 4 then
        Grab(args[0], args[1], args[2], args[3], null, acceptComputer)
    else if args.len == 5 then
        Grab(args[0], args[1], args[2], args[3], args[4], acceptComputer)
    else
        print("<b>Usage: grab [ip] [port] [opt:mem] [opt:val] [opt:inject] [opt:-c] [opt:-push]")
        print(c.grey + "  -c      accept computer objects (not just shells)" + c.ennd)
        print(c.grey + "  -push   push result onto stack automatically" + c.ennd)
    end if
    if autoPush and (typeof(object) == "shell" or (acceptComputer and typeof(object) == "computer")) then
        objectStack.push(object)
        print(c.lime + "  [+] pushed to stack [" + objectStack.len + "]" + c.ennd)
    end if
end function
CommandTable["grab"] = @CmdGrab


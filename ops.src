// -- RTGen - write rainbow table to disk --------------------------

CrackHash = function(hash)
    if not gco.hasIndex("rt") or gco.rt == null then buildRainbowTable
    if gco.rt.hasIndex(hash) then return gco.rt[hash]
    if gco.crypto then
        pw = gco.crypto.decipher(hash)
        if pw then RtLearn(hash, pw)
        return pw
    end if
    return null
end function

// -- ArLocal --------------------------------------------------------
// Local counterpart to ar/autoroot. The remote path (ar, below) uploads
// a compiled dictionary-attack binary to a held/connected target and
// cracks its /etc/shadow there — there's no "target" for that when the
// machine to crack is the one phantom is already running on. Instead
// this reuses ChainSaw's own local mode: ChainSaw.connect falls back to
// get_shell(user, password) (a local login attempt) whenever
// ChainSaw.ip is blank, same mechanism 'chainsaw run' uses without
// --ip=. A successful shell goes to lObject, matching Escalate's
// local-privesc convention — object/remotePath are for a held REMOTE
// target, which this isn't.
ArLocal = function(userArg)
    user = "root"
    if userArg then user = userArg
    print(c.orange + "Cracking local " + user + " password (ChainSaw)..." + c.ennd)
    ChainSaw.ip = ""
    ChainSaw.user = user
    ChainSaw.init
    result = ChainSaw.crack(true)
    if result then
        globals.lObject = result
        // also leave it in gco for another phantom instance to pick up
        // via "claim" — e.g. jump to a target, autoroot -l yourself
        // there, then run claim from your original session to have
        // that root shell land in globals.object back home. gco is a
        // persistent, player-scoped store (same reason slb.src/wsx.src
        // already hand live shell/computer objects back across a
        // launch boundary between two different machines), so this
        // works the same way across two independent phantom sessions.
        gco.claimShell = result
        print(c.lime + "<b>local " + user + " shell acquired!" + c.ennd)
        print(c.gold + "  password: " + ChainSaw.password + c.ennd)
        print(c.grey + "  left for pickup — run 'claim' from another phantom session to grab it" + c.ennd)
        globals.pipeFailed = false
    else
        print(c.yellow + "<b>ar -l: failed to crack local " + user + " password" + c.ennd)
        globals.pipeFailed = true
    end if
end function

// -- AutoRoot -----------------------------------------------------
ar = function(ip, user, pass)
    if typeof(object) != "shell" then
        if not ip then
            print(c.yellow + "<b>autoroot: not holding remote shell" + c.ennd)
            print(c.grey + "  usage: autoroot [ip] [user] [pass]" + c.ennd)
            return
        end if
        print(c.orange + "Connecting to " + ip + " ..." + c.ennd)
        s = myShell.connect_service(ip, 22, user, pass, "ssh")
        if typeof(s) != "shell" then
            print(c.yellow + "<b>autoroot: could not connect to " + ip + c.ennd)
            return
        end if
        globals.object = s
        globals.remotePath = "/"
        print(c.cyan + "shell obtained: " + ip + c.ennd)
    end if
    comp = object.host_computer

    // already root? skip
    if IsRoot(object) then
        print(c.lime + "autoroot: already have root on " + comp.public_ip + c.ennd)
        return
    end if

    // find writable path on target
    writePath = null
    for path in ["/home/guest", "/tmp", "/root"]
        testDir = comp.File(path)
        if testDir and testDir.has_permission("w") then
            writePath = path
            break
        end if
    end for
    if not writePath then
        print(c.yellow + "<b>autoroot: no writable path on target" + c.ennd)
        return
    end if

    // upload ar binary
    arBin = myComp.File(currentPath + "/ar")
    if not arBin then
        print(c.yellow + "<b>autoroot: ar binary not found in " + currentPath + c.ennd)
        print(c.grey + "  build ar.src locally: build ar.src " + currentPath + c.ennd)
        return
    end if
    print(c.orange + "Uploading ar to " + writePath + " ..." + c.ennd)
    myShell.scp(currentPath + "/ar", writePath, object)
    binFile = comp.File(writePath + "/ar")
    if not binFile then
        globals.pipeFailed = true
        print(c.yellow + "<b>autoroot: ar upload failed" + c.ennd)
        return
    end if
    // dictionary attack from the raw seed words (pregens/rockyou/onboard
    // tables) — real words only, not the markov-generated rainbow table
     // pass 1 dictionary (tables), pass 2 markov-generated (rt) as fallback
    if not gco.hasIndex("seedWords") or gco.seedWords == null then buildRainbowTable
    if not gco.hasIndex("rt") or gco.rt == null then buildRainbowTable
    allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    passList = []
    seen = {}

    // pass 1: real dictionary words
    for pw in gco.seedWords
        ok = true
        for i in range(0, pw.len - 1)
            if allowed.indexOf(pw[i]) == null then ok = false; break
        end for
        if ok and not seen.hasIndex(pw) then
            seen[pw] = 1
            passList.push(pw)
        end if
    end for

    // pass 2: markov-generated passwords from the rainbow table
    for hash in gco.rt.indexes
        pw = gco.rt[hash]
        ok = true
        for i in range(0, pw.len - 1)
            if allowed.indexOf(pw[i]) == null then ok = false; break
        end for
        if ok and not seen.hasIndex(pw) then
            seen[pw] = 1
            passList.push(pw)
        end if
    end for

    print(c.orange + "Running " + passList.len + " passwords against target..." + c.ennd)
    batchSize = 10000

    i = 0
    gco.rootShell = null
    while i < passList.len and not gco.rootShell
		print(c.grey + "[DEBUG] i = " + i + " batchsize = " + batchSize + " passlist = " + passList.len + c.ennd)
        batch = passList[i : i + batchSize]
        object.launch(writePath + "/ar", batch.join(" "))
        i = i + batchSize
    end while
	
    binFile.delete

    if gco.rootShell then
        globals.object = gco.rootShell
        globals.remotePath = "/"
        gco.rootShell = null
        print(char(10) + c.purple + "<b>autoroot: root shell obtained" + c.ennd)
        GETPERMS(globals.object)
    else
        globals.pipeFailed = true
        print(c.yellow + "<b>autoroot: failed" + c.ennd)
    end if
end function

// -- AutorootStack ------------------------------------------------
// Runs autoroot against every shell on the objectStack,
// replacing each entry with a root shell on success.
astack = function(libArg)
    if libArg == null then libArg = "init.so"
    if objectStack.len == 0 then
        print(c.yellow + "<b>autoroot --stack: stack is empty" + c.ennd)
        return
    end if

    shells = []
    indices = []
    i = 0
    while i < objectStack.len
        if typeof(objectStack[i]) == "shell" then
            shells.push(objectStack[i])
            indices.push(i)
        end if
        i = i + 1
    end while

    if shells.len == 0 then
        print(c.yellow + "<b>autoroot --stack: no shell objects on stack" + c.ennd)
        return
    end if

    savedObject = globals.object
    rootCount = 0
    failCount = 0
    print(c.cyan + "<b>astack: escalating " + shells.len + " shell(s)..." + c.ennd)
    div

    i = 0
    for sh in shells
        rcomp = sh.host_computer
        print(c.orange + "<b>[" + (i+1) + "/" + shells.len + "] " + rcomp.public_ip + "  lan:" + rcomp.local_ip + c.ennd)
        if IsRoot(sh) then
            print(c.lime + "  already root — planting..." + c.ennd)
            rootCount = rootCount + 1
            srcPath = "/root/InsecureLibs/" + libArg
            if not myComp.File(srcPath) then srcPath = "/root/InsecureLibs/init.so"
            if myComp.File(srcPath) then
                r1 = myShell.scp(srcPath, "/lib", sh)
                if typeof(r1) != "string" or r1 == "" then
                    print(c.lime + "  [+] planted init.so" + c.ennd)
                end if
            end if
            mxSrc = "/lib/metaxploit.so"
            if myComp.File(mxSrc) then
                r2 = myShell.scp(mxSrc, "/lib", sh)
                if typeof(r2) != "string" or r2 == "" then
                    print(c.lime + "  [+] planted metaxploit.so" + c.ennd)
                end if
            end if
            i = i + 1
            continue
        end if
        globals.object = sh
        globals.pipeFailed = false
        ar(null, null, null)
        if not globals.pipeFailed then
            objectStack[indices[i]] = globals.object
            rootCount = rootCount + 1
            // plant lib + metaxploit now we have root
            srcPath = "/root/InsecureLibs/" + libArg
            if not myComp.File(srcPath) then srcPath = "/root/InsecureLibs/init.so"
            if myComp.File(srcPath) then
                r1 = myShell.scp(srcPath, "/lib", globals.object)
                if typeof(r1) != "string" or r1 == "" then
                    print(c.lime + "  [+] planted init.so" + c.ennd)
                end if
            end if
            mxSrc = "/root/metaxploit.so"
            if myComp.File(mxSrc) then
                r2 = myShell.scp(mxSrc, "/lib", globals.object)
                if typeof(r2) != "string" or r2 == "" then
                    print(c.lime + "  [+] planted metaxploit.so" + c.ennd)
                end if
            end if
        else
            globals.pipeFailed = false
            failCount = failCount + 1
        end if
        div
        i = i + 1
    end for

    globals.object = savedObject
    globals.pipeFailed = false
    print(c.cyan + "<b>autoroot --stack complete" + c.ennd)
    print(c.grey + "  escalated: " + rootCount + "  failed: " + failCount + c.ennd)
end function

// ── RGrep ────────────────────────────────────────────────────────
// Search file contents recursively for a pattern
RGrep = function(pattern, path, obj)
    comp = null
    if typeof(obj) == "shell" then comp = obj.host_computer
    if typeof(obj) == "computer" then comp = obj
    if not comp then
        print(c.yellow + "<b>rgrep: no target" + c.ennd)
        return null
    end if
    if not path or path == "" then path = "/"
    root = comp.File(path)
    if not root then
        print(c.yellow + "<b>rgrep: path not found: " + path + c.ennd)
        return null
    end if
    matchedLines = []
    queue = []
    if root.is_folder then
        queue = root.get_files + root.get_folders
    else
        queue = [root]
    end if
    while queue.len > 0
        f = queue.pull
        if not f then continue
        if f.is_folder then
            queue = queue + f.get_files + f.get_folders
            continue
        end if
        if not f.has_permission("r") then continue
        content = f.get_content
        if not content or content == "" then continue
        lines = content.split(char(10))
        ln = 1
        for line in lines
            if line.indexOf(pattern) != null then
                print(c.gold + f.path + c.ennd + c.grey + ":" + ln + c.ennd + "  " + line)
                matchedLines.push(line)
            end if
            ln = ln + 1
        end for
    end while
    return matchedLines
end function

// ── RFind ────────────────────────────────────────────────────────
// Find files/folders by name pattern recursively
RFind = function(pattern, path, obj, matchList = null)
    comp = null
    if typeof(obj) == "shell" then comp = obj.host_computer
    if typeof(obj) == "computer" then comp = obj
    if not comp then
        print(c.yellow + "<b>rfind: no target" + c.ennd)
        return 0
    end if
    if not path or path == "" then path = "/"
    root = comp.File(path)
    if not root then
        print(c.yellow + "<b>rfind: path not found: " + path + c.ennd)
        return 0
    end if
    found = 0
    queue = [root]
    while queue.len > 0
        f = queue.pull
        if not f then continue
        if f.name.indexOf(pattern) != null then
            icon = ""
            if f.is_folder then icon = "/"
            print(c.gold + f.path + icon + c.ennd)
            found = found + 1
            if matchList != null then matchList.push(f.path)
        end if
        if f.is_folder then
            queue = queue + f.get_files + f.get_folders
        end if
    end while
    return found
end function

// -- Nslookup -------------------------------------------------------
Nslookup = function(params)
    if params.len < 1 then
        print(c.red + "Invalid Address")
        return null
    end if
    result = nslookup(params[0])
    if result == null or result == "" then
        print(c.red + "Lookup failed for " + params[0])
        return null
    end if
    print(c.gold + result)
    return result
end function


// ── stacklan ─────────────────────────────────────────────────────
// stacklan <lanip>        switch to the stack object with that LAN ip
// stacklan <pubip> -p     match public ip instead (first hit)
// stacklan                list every stack object's pub/lan ip
CmdStacklan = function(inp)
    if objectStack.len == 0 then
        print(c.yellow + "<b>stacklan: stack is empty" + c.ennd)
        globals.pipeFailed = true
        return
    end if

    // no arg: just list them
    if inp.len < 2 then
        i = 1
        for obj in objectStack
            comp = obj
            if typeof(obj) == "shell" then comp = obj.host_computer
            if typeof(comp) == "computer" then
                print(c.grey + "  [" + i + "] " + c.ennd + c.white + comp.local_ip + c.ennd + c.grey + "  pub:" + comp.public_ip + "  (" + typeof(obj) + ")" + c.ennd)
            end if
            i = i + 1
        end for
        return
    end if

    target  = inp[1]
    usePub  = inp.indexOf("-p") != null
    found   = null
    foundIx = 0

    i = 1
    for obj in objectStack
        comp = obj
        if typeof(obj) == "shell" then comp = obj.host_computer
        if typeof(comp) == "computer" then
            ip = comp.local_ip
            if usePub then ip = comp.public_ip
            if ip == target then
                found   = obj
                foundIx = i
                break
            end if
        end if
        i = i + 1
    end for

    if found == null then
        print(c.yellow + "<b>stacklan: no stack object with ip " + target + c.ennd)
        globals.pipeFailed = true
        return
    end if

    globals.object = found
    comp = found
    if typeof(found) == "shell" then comp = found.host_computer
    print(c.green + "stacklan: [" + foundIx + "] " + comp.local_ip + "  pub:" + comp.public_ip + " (" + typeof(found) + ")" + c.ennd)
    globals.pipeResult = comp.local_ip
    GETPERMS(globals.object)
end function
CommandTable["stacklan"] = @CmdStacklan

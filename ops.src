// inp[0] is the raw "r./binname" token
CmdRemoteBinary = function(inp)
    cmd = inp[0]
    if typeof(object) != "shell" then
        print(c.yellow + "<b>r./: not holding remote shell" + c.ennd)
    else
        rcomp = object.host_computer
        bname = cmd[3:]
        f = null
        if bname.len > 0 and bname[0] == "/" then
            f = rcomp.File(bname)
        else
            searchPaths = [remotePath, "/root", "/home/guest", "/bin", "/usr/bin"]
            for sp in searchPaths
                candidate = rcomp.File(sp + "/" + bname)
                if candidate then
                    f = candidate
                    break
                end if
            end for
        end if
        if not f then
            print(c.yellow + "<b>r./: not found: " + bname + c.ennd)
        else if not f.is_binary then
            print(c.yellow + "<b>r./: not a binary: " + f.path + c.ennd)
        else if inp.len > 1 then
            object.launch(f.path, inp[1:].join(" "))
        else
            object.launch(f.path)
        end if
    end if
end function

CmdAr = function(inp)
    if inp.indexOf("-l") != null then
        userArg = null
        lIdx = inp.indexOf("-l")
        if lIdx + 1 < inp.len then userArg = inp[lIdx + 1]
        ArLocal(userArg)
    else
        ar(null, null, null)
    end if
end function
CommandTable["ar"] = @CmdAr


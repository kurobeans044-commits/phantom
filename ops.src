// inp[0] is the raw "./binname" token
CmdLocalBinary = function(inp)
    cmd = inp[0]
    f = GetFile(cmd[2:], myComp, true)
    if not f then
        print(c.yellow + "<b>./: not found: " + cmd[2:] + c.ennd)
    else if not f.is_binary then
        print(c.yellow + "<b>./: not a binary" + c.ennd)
    else if inp.len > 1 then
        myShell.launch(f.path, inp[1:].join(" "))
    else
        myShell.launch(f.path)
    end if
end function


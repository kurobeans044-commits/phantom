CmdNslookup = function(inp)
    if inp.len < 2 then
        print("<b>Usage: nslookup <domain or ip> [@var]")
    else
        result = Nslookup([inp[1]])
        if result != null then
            globals.pipeResult = result
            if inp.len >= 3 then
                k = inp[2]
                if k[0:1] == "@" then k = k[1:]
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[k] = result
                pipeVars[k] = result
                print(c.lime + "  @" + k + " = " + result + c.ennd)
            end if
        else
            globals.pipeFailed = true
        end if
    end if
end function
CommandTable["nslookup"] = @CmdNslookup


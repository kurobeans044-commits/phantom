end function
CommandTable["whois"] = @CmdWhois

CmdWhoismail = function(inp)
    if inp.len < 2 then
        print("<b>Usage: whoismail <ip> [@var]")
        print(c.grey + "  extracts admin email from whois and clips it" + c.ennd)
    else
        wip = inp[1]
        if wip == "pt" then wip = publicTarget
        if not is_valid_ip(wip) or is_lan_ip(wip) then
            print(c.yellow + "<b>whoismail: need a public ip" + c.ennd)
            globals.pipeFailed = true
        else
            wdata = whois(wip)
            wemail = null
            for wline in wdata.split(char(10))
                if wline.indexOf("@") != null then
                    for wpart in wline.split(" ")
                        if wpart.indexOf("@") != null then
                            wemail = wpart
                        end if
                        if wemail != null then break
                    end for
                end if
                if wemail != null then break
            end for
            if wemail == null or wemail == "" then
                print(c.yellow + "<b>whoismail: no email found in whois for " + wip + c.ennd)
                globals.pipeFailed = true
            else
                print(c.cyan + "whoismail: " + wemail + c.ennd)
                globals.pipeResult = wemail
                k = "email"
                if inp.len >= 3 then
                    k = inp[2]
                    if k[0:1] == "@" then k = k[1:]
                end if
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[k] = wemail
                pipeVars[k] = wemail
                print(c.lime + "  @" + k + " = " + wemail + c.ennd)
            end if
        end if
    end if
end function
CommandTable["whoismail"] = @CmdWhoismail


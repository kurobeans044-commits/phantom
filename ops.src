    astack(libArg)
end function
CommandTable["astack"] = @CmdAstack

CmdAutoroot = function(inp)
    if inp.indexOf("-l") != null then
        userArg = null
        lIdx = inp.indexOf("-l")
        if lIdx + 1 < inp.len then userArg = inp[lIdx + 1]
        ArLocal(userArg)
    else if inp.indexOf("--stack") != null then
        // ChainSaw deploy to all stack objects
        if objectStack.len == 0 then
            print(c.yellow + "<b>autoroot --stack: stack is empty" + c.ennd)
        else
            print(c.orange + "Loading ChainSaw..." + c.ennd)
            ChainSaw.load
            wait(1)

            print(char(10) + c.cyan + "<b>AUTOROOT STACK (ChainSaw)" + c.ennd)
            print(c.grey + "  targeting " + objectStack.len + " object(s)" + c.ennd)
            print(c.grey + "================================================================" + c.ennd)
            savedObject = globals.object
            savedPath   = globals.remotePath
            rooted = 0
            idx = 1
            stackI = 0
            while stackI < objectStack.len
                stackObj = objectStack[stackI]
                stackI = stackI + 1
                if typeof(stackObj) != "shell" then
                    idx = idx + 1
                    continue
                end if
                if IsRoot(stackObj) then
                    print(char(10) + c.lime + "[" + idx + "/" + objectStack.len + "] " + stackObj.host_computer.public_ip + " — already root" + c.ennd)
                    rooted = rooted + 1
                    idx = idx + 1
                    continue
                end if
                globals.object = stackObj
                globals.remotePath = "/"
                comp = stackObj.host_computer
                print(char(10) + c.orange + "[" + idx + "/" + objectStack.len + "] " + comp.public_ip + c.ennd)

                rcePath = "/home/guest"
                rceName = "chainsaw_rce"
                rceSrc = rcePath + "/" + rceName + ".src"

                n = char(10)
                rceLines = []
                rceLines.push("chainsaw = get_custom_object.chainsaw")
                rceLines.push("chainsaw.load_samples")
                rceLines.push("chainsaw.load_pregens")
                rceLines.push("chainsaw.load_chains")
                rceLines.push("chainsaw.crack(false)")
                rceString = rceLines.join(n)

                comp.touch(rcePath, rceName + ".src")
                rceFile = comp.File(rceSrc)
                if not rceFile then
                    print(c.yellow + "  could not create RCE script" + c.ennd)
                else
                    rceFile.set_content(rceString)
                    print(c.grey + "  building chainsaw_rce..." + c.ennd)
                    buildRes = stackObj.build(rceSrc, rcePath)
                    if typeof(buildRes) == "string" and buildRes != "" then
                        print(c.yellow + "  build failed: " + buildRes + c.ennd)
                    else
                        // clear any shell left over from a previous target so a
                        // ChainSaw failure here can't read as a false success
                        gcoCS = get_custom_object
                        if gcoCS.hasIndex("chainsaw") then gcoCS.chainsaw.shell = null

                        print(c.grey + "  launching ChainSaw..." + c.ennd)
                        stackObj.launch(rcePath + "/" + rceName)
                        wait(2)

                        if gcoCS.hasIndex("chainsaw") and gcoCS.chainsaw.shell != null then
                            rootShell = gcoCS.chainsaw.shell
                            // write the root shell back into the stack slot
                            objectStack[stackI - 1] = rootShell
                            globals.object = rootShell
                            globals.remotePath = "/"
                            print(c.green + "  [+] rooted via ChainSaw" + c.ennd)
                            print(c.gold + "      password: " + gcoCS.chainsaw.password + c.ennd)

                            print(c.orange + "  planting weaklib..." + c.ennd)
                            PlantToObject(["libhttp.so"], "/lib")

                            rooted = rooted + 1
                        else
                            print(c.yellow + "  ChainSaw failed" + c.ennd)
                        end if
                    end if
                end if
                idx = idx + 1
            end while
            globals.object = savedObject
            globals.remotePath = savedPath
            div
            print(c.cyan + "<b>autoroot --stack complete — " + rooted + "/" + objectStack.len + " rooted" + c.ennd)
        end if
    else if inp.len == 1 or inp.len == 4 then
        // Single target mode: autoroot (held shell) OR autoroot [ip] [user] [pass] (ignored, uses held shell)
        if not object or typeof(object) != "shell" then
            print(c.yellow + "<b>autoroot: need a remote shell to deploy ChainSaw" + c.ennd)
        else
            print(c.orange + "Loading ChainSaw..." + c.ennd)

            comp = object.host_computer
            print(char(10) + c.cyan + "<b>AUTOROOT (ChainSaw)" + c.ennd)
            print(c.grey + "  target: " + comp.public_ip + c.ennd)

            rcePath = "/home/guest"
            rceName = "chainsaw_rce"
            rceSrc = rcePath + "/" + rceName + ".src"

            n = char(10)
            rceLines = []
            rceLines.push("chainsaw = get_custom_object.chainsaw")
            rceLines.push("chainsaw.load_samples")
            rceLines.push("chainsaw.load_pregens")
            rceLines.push("chainsaw.load_chains")
            rceLines.push("chainsaw.crack(false)")
            rceString = rceLines.join(n)

            comp.touch(rcePath, rceName + ".src")
            rceFile = comp.File(rceSrc)
            if not rceFile then
                print(c.yellow + "  could not create RCE script" + c.ennd)
            else
                rceFile.set_content(rceString)
                print(c.orange + "  building chainsaw_rce..." + c.ennd)
                buildRes = object.build(rceSrc, rcePath)
                if typeof(buildRes) == "string" and buildRes != "" then
                    print(c.yellow + "  build failed: " + buildRes + c.ennd)
                else
                    print(c.orange + "  launching ChainSaw..." + c.ennd)
                    object.launch(rcePath + "/" + rceName)
                    wait(2)

                    gcoCS = get_custom_object
                    if gcoCS.hasIndex("chainsaw") and gcoCS.chainsaw.shell != null then
                        globals.object = gcoCS.chainsaw.shell
                        globals.remotePath = "/"
                        print(c.green + "<b>[+] ROOTED via ChainSaw!" + c.ennd)
                        print(c.gold + "  password: " + gcoCS.chainsaw.password + c.ennd)

                        print(c.orange + "  planting weaklib..." + c.ennd)
                        PlantToObject(["libhttp.so"], "/lib")
                    else
                        print(c.yellow + "  ChainSaw failed" + c.ennd)
                    end if
                end if
            end if
        end if
    else
        print("<b>Usage: autoroot  |  autoroot --stack  |  autoroot dict [pw1 pw2...]")
    end if
end function
CommandTable["autoroot"] = @CmdAutoroot

CmdLanenum = function(inp)
    localMode = inp.indexOf("-l") != null
    args = []
    for a in inp[1:]
        if a != "-l" then args.push(a)
    end for
    sv = null
    if args.len >= 1 then
        sv = args[0]
        if sv[0:1] == "@" then sv = sv[1:]
    end if
    LanEnum(sv, localMode)
end function
CommandTable["lanenum"] = @CmdLanenum

CmdStackgrep = function(inp)
    if inp.len < 2 then
        print("<b>Usage: stackgrep <pattern> [path] [@var]")
    else if objectStack.len == 0 then
        print(c.yellow + "<b>stackgrep: stack is empty" + c.ennd)
    else
        path = "/"
        storeKey = null
        if inp.len >= 3 and inp[-1][0:1] == "@" then
            storeKey = inp[-1][1:]
            path = inp[2:-1].join(" ")
        else if inp.len >= 3 then
            path = inp[2]
        end if
        allMatches = []
        i = 1
        for obj in objectStack
            if typeof(obj) != "shell" and typeof(obj) != "computer" then
                i = i + 1
                continue
            end if
            comp = obj
            if typeof(obj) == "shell" then comp = obj.host_computer
            print(c.cyan + "<b>[" + i + "] " + comp.public_ip + c.ennd + c.grey + "  lan:" + comp.local_ip + c.ennd)
            lines3 = RGrep(inp[1], path, obj)
            if lines3 != null then
                for ml in lines3
                    allMatches.push(ml)
                end for
            end if
            i = i + 1
        end for
        div
        print(c.cyan + "stackgrep: " + allMatches.len + " total match(es) across " + objectStack.len + " object(s)" + c.ennd)
        if allMatches.len > 0 then
            joined = allMatches.join(",")
            globals.pipeResult = joined
            if storeKey != null then
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[storeKey] = joined
                pipeVars[storeKey] = joined
                print(c.lime + "  @" + storeKey + " = " + joined + c.ennd)
            end if
        else
            globals.pipeFailed = true
        end if
    end if
end function
CommandTable["stackgrep"] = @CmdStackgrep

CmdStackfind = function(inp)
    if inp.len < 2 then
        print("<b>Usage: stackfind <pattern> [path] [@var]")
    else if objectStack.len == 0 then
        print(c.yellow + "<b>stackfind: stack is empty" + c.ennd)
    else
        path = "/"
        storeKey = null
        if inp.len >= 3 and inp[-1][0:1] == "@" then
            storeKey = inp[-1][1:]
            path = inp[2:-1].join(" ")
        else if inp.len >= 3 then
            path = inp[2]
        end if
        total = 0
        i = 1
        allMatches = []
        for obj in objectStack
            if typeof(obj) != "shell" and typeof(obj) != "computer" then
                i = i + 1
                continue
            end if
            comp = obj
            if typeof(obj) == "shell" then comp = obj.host_computer
            print(c.cyan + "<b>[" + i + "] " + comp.public_ip + c.ennd + c.grey + "  lan:" + comp.local_ip + c.ennd)
            n = RFind(inp[1], path, obj, allMatches)
            total = total + n
            i = i + 1
        end for
        div
        print(c.cyan + "stackfind: " + total + " total result(s) across " + objectStack.len + " object(s)" + c.ennd)
        if total > 0 then
            joined = allMatches.join(",")
            globals.pipeResult = joined
            if storeKey != null then
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[storeKey] = joined
                pipeVars[storeKey] = joined
                print(c.lime + "  @" + storeKey + " = " + joined + c.ennd)
            end if
        end if
    end if
end function
CommandTable["stackfind"] = @CmdStackfind

CmdCrack = function(inp)
    if inp.len == 2 then
        if not gco.hasIndex("rt") or gco.rt == null then buildRainbowTable
        result = CrackHash(inp[1])
        if result then
            print(c.gold + "<b>cracked: " + result + c.ennd)
        else
            print(c.yellow + "<b>crack: hash not found in table" + c.ennd)
        end if
    else
        print("<b>Usage: crack [hash]")
    end if
end function
CommandTable["crack"] = @CmdCrack

CmdBuildrt = function(inp)
    // buildrt [order] [minLen] [maxLen]
    // defaults: order=3 min=3 max=12  →  ~48k passwords
    // example:  buildrt 2 3 14        →  ~200k+ passwords
    oA = null
    mnA = null
    mxA = null
    if inp.len >= 2 then oA  = inp[1].to_int
    if inp.len >= 3 then mnA = inp[2].to_int
    if inp.len >= 4 then mxA = inp[3].to_int
    gco.rt = null
    buildRainbowTable(oA, mnA, mxA)
end function
CommandTable["buildrt"] = @CmdBuildrt


// ── Cmd wrappers — each self-registers into CommandTable right after ─────
// ── its own definition (see the CommandTable[...] line below it) ─────
CmdHelp = function(inp)
    if inp.len == 1 then ShowHelp(null) else ShowHelp(inp[1])
end function
CommandTable["help"] = @CmdHelp

CmdTree = function(inp)

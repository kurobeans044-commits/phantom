// ── Cmd wrappers — each self-registers into CommandTable right after ─────
// ── its own definition (see the CommandTable[...] line below it) ─────
CmdTerm = function(inp)
    myShell.launch("/usr/bin/Terminal.exe")
end function
CommandTable["term"] = @CmdTerm
RTerm = function(inp)
if object == null then
	return print(c.orange + "Need to be Holding Remote Shell")
	else
	object.launch("/usr/bin/Terminal.exe")
    end if
end function
CommandTable["rterm"] = @RTerm

RB = function(inp)
if object == null then
    return print(c.orange + "Need to be Holding Remote Shell")
    else
    object.launch("/usr/bin/Browser.exe")
    end if
end function
CommandTable["rb"] = @RB

RFile = function(inp)
if object == null then
    return print(c.orange + "Need to be Holding Remote Shell")
    else
    object.launch("/usr/bin/FileExplorer.exe")
    end if
end function
CommandTable["rfile"] = @RFile

CmdMail = function(inp)
    myShell.launch("/usr/bin/Mail.exe")
end function
CommandTable["mail"] = @CmdMail

CmdBrowser = function(inp)
    myShell.launch("/usr/bin/Browser.exe")
end function
CommandTable["b"] = @CmdBrowser
proxy = function(inp)
    myShell.launch("/usr/bin/Browser.exe")
end function
CmdFileExplorer = function(inp)
    myShell.launch("/usr/bin/FileExplorer.exe")
end function
CommandTable["file"] = @CmdFileExplorer

CmdPwnlan = function(inp)
    PwnLan
end function
CommandTable["pwnlan"] = @CmdPwnlan

CmdUpgrade = function(inp)
    if inp.len >= 2 and inp[1] == "-u" then
        Upgrade(false)
    else
        Upgrade(true)
    end if
end function
CommandTable["upgrade"] = @CmdUpgrade

CmdUpdatelib = function(inp)
    UpdateLib()
end function
CommandTable["updatelib"] = @CmdUpdatelib

CmdStudent = function(inp)
if object == null then
	print(c.red + char(9) + "[!] Must Be Holding Remote Shell")
	return
end if
object.launch("/root/StudentsViewer.exe")
end function

// jump [opt:--rshell] [opt:-b|--bin] [opt:--loadlib name]
// -b/--bin: upload just the compiled phantom binary (+ the same
// metaxploit.so/crypto.so/librshell.so companions any jump needs)
// instead of the whole tp folder — quicker when all you want on the
// other end is to loadlib/uselib and come back, not the full toolkit.
// --loadlib name: skip the interactive nested session entirely — the
// target auto-loads that lib from ITS OWN /lib and exits immediately,
// bringing it home via the usual gco.local carry. Chain straight into
// uselib with the existing |> stage syntax, e.g.
// "jump --loadlib libhttp.so |> uselib -l 10.0.15.5 -c" — one command,
// no manual typing on the target at all. Implies -b/--bin automatically
// (grabbing a lib and coming home never needs the whole tp folder) —
// pass -b explicitly too if you like, it's a no-op either way.
CmdJump = function(inp)
    loadLibName = null
    llIdx = inp.indexOf("--loadlib")
    if llIdx != null and llIdx + 1 < inp.len then loadLibName = inp[llIdx + 1]
    binOnly = inp.indexOf("-b") != null or inp.indexOf("--bin") != null or loadLibName != null
    if inp.indexOf("--rshell") != null then
        Propagate(true, false, loadLibName)
    else
        Propagate(false, binOnly, loadLibName)
    end if
end function
CommandTable["jump"] = @CmdJump

// jumpbin — dedicated bin-only jump, no flag parsing at all. Isolates
// whether Propagate's binOnly branch itself works, decoupled from
// whatever's eating -b on `jump -b`.
CmdJumpBin = function(inp)
    loadLibName = null
    if inp.len >= 3 and inp[1] == "--loadlib" then loadLibName = inp[2]
    Propagate(false, true, loadLibName)
end function
CommandTable["jumpbin"] = @CmdJumpBin


// ── Utility ──────────────────────────────────────────────────────
div = function()
    print(c.grey + "----------------------------------------------------------------" + c.ennd)
end function
Title = function()
    clear_screen
    r = [c.cyan, c.lime, c.pink, c.gold, c.purple, c.copper, c.teal, c.rust]
    r.shuffle
    a = r[0]
    b = r[1]
	d = r[2]
    print(char(10))
    print(a+"<b>  ██████╗ ██╗  ██╗ █████╗ ███╗  ██╗████████╗ ██████╗ ███╗  ███╗"+c.ennd)
    print(a+"<b>  ██╔══██╗██║  ██║██╔══██╗████╗ ██║╚══██╔══╝██╔═══██╗████╗████║"+c.ennd)
    print(b+"<b>  ██████╔╝███████║███████║██╔██╗██║   ██║   ██║   ██║██╔████╔██║"+c.ennd)
    print(b+"<b>  ██╔═══╝ ██╔══██║██╔══██║██║╚████║   ██║   ██║   ██║██║╚██╔╝██║"+c.ennd)
    print(a+"<b>  ██║     ██║  ██║██║  ██║██║ ╚███║   ██║   ╚██████╔╝██║ ╚═╝ ██║"+c.ennd)
    print(a+"<b>  ╚═╝     ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚══╝   ╚═╝    ╚═════╝ ╚═╝     ╚═╝"+c.ennd)
    print(d+"                                              v1.8  by operator"+c.ennd)
    print(char(10))

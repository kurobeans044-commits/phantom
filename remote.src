CmdRtree = function(inp)
    if not object then
        print(c.yellow + "<b>rtree: not holding remote object" + c.ennd)
    else
        path = remotePath
        if inp.len == 2 then path = inp[1]
        Tree(path, object, false, null)
    end if
end function
CommandTable["rtree"] = @CmdRtree

CmdRls = function(inp)
    if not object then
        print(c.yellow + "<b>rls: not holding remote object" + c.ennd)
    else
        Ls(inp, remotePath, object, false)
    end if
end function
CommandTable["rls"] = @CmdRls

CmdRcd = function(inp)
    if not object then
        print(c.yellow + "<b>rcd: not holding remote object" + c.ennd)
    else if inp.len == 1 then
        globals.remotePath = "/"
    else if inp[1] == ".." then
        comp = object.host_computer
        if typeof(object) != "shell" then comp = object
        f = comp.File(remotePath).parent
        if f then globals.remotePath = f.path
    else
        f = GetFile(inp[1], object, false)
        if f and f.is_folder then
            globals.remotePath = f.path
        else
            print(c.yellow + "<b>rcd: not found" + c.ennd)
        end if
    end if
end function
CommandTable["rcd"] = @CmdRcd

CmdRcat = function(inp)
    if not object then
        print(c.yellow + "<b>rcat: not holding remote object" + c.ennd)
    else if inp.len >= 2 then
        Cat(inp[1], object, false)
    else
        print("<b>Usage: rcat [file]")

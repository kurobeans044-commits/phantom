// rwhoami — current user on the held remote shell (remote whoami)
CmdRwhoami = function(inp)
    if typeof(object) != "shell" then
        print(c.yellow + "<b>rwhoami: not holding remote shell" + c.ennd)
        globals.pipeFailed = true
        return
    end if
    // no shell.whoami in this build — derive it: root if /etc/passwd is
    // writable, else the /home folder this shell can write into (the user)
    comp = object.host_computer
    u = ""
    pf = comp.File("/etc/passwd")
    if pf and pf.has_permission("w") then
        u = "root"
    else
        home = comp.File("/home")
        if home then
            for d in home.get_folders
                if d.name != "" and d.has_permission("w") then
                    u = d.name
                    break
                end if
            end for
        end if
    end if
    if u == "" then u = "(unknown)"
    print(c.cyan + "rwhoami: " + c.ennd + c.gold + u + c.ennd)
    globals.pipeResult = u
    globals.pipeFailed = false
end function
CommandTable["rwhoami"] = @CmdRwhoami

CmdRdecipher = function(inp)
    if inp.len == 3 then
        if not object then
            print(c.yellow + "<b>rdecipher: not holding remote object" + c.ennd)
        else
            Decipher(inp[1], inp[2], object)
        end if
    else if inp.len == 2 then
        DecipherBatch(inp[1])
    else if pipeResult != "" then
        DecipherBatch(pipeResult)
    else
        print("<b>Usage: rdecipher [-h user:hash] [-f /path/file]" + char(10) + "-- or rdecipher @clip / harvest | clip @a | rdecipher to crack an entire comma-separated user:hash list at once")
    end if
end function
CommandTable["rdecipher"] = @CmdRdecipher

CmdRgrep = function(inp)
    if inp.len < 2 then
        print("<b>Usage: rgrep <pattern> [path] [@var]")
    else if not object then
        print(c.yellow + "<b>rgrep: not holding remote object" + c.ennd)
    else
        path = "/"
        storeKey = null
        if inp.len >= 3 and inp[-1][0:1] == "@" then
            storeKey = inp[-1][1:]
            path = inp[2:-1].join(" ")
        else if inp.len >= 3 then
            path = inp[2]
        end if
        print(c.orange + "Searching for '" + inp[1] + "' in " + path + " ..." + c.ennd)
        matchedLines = RGrep(inp[1], path, object)
        if matchedLines == null or matchedLines.len == 0 then
            print(c.yellow + "<b>rgrep: no matches" + c.ennd)
            globals.pipeFailed = true
        else
            print(c.cyan + "rgrep: " + matchedLines.len + " match(es)" + c.ennd)
            joined = matchedLines.join(",")
            globals.pipeResult = joined
            if storeKey != null then
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[storeKey] = joined
                pipeVars[storeKey] = joined
                print(c.lime + "  @" + storeKey + " = " + joined + c.ennd)
            end if
        end if
    end if
end function
CommandTable["rgrep"] = @CmdRgrep

CmdRfind = function(inp)
    if inp.len < 2 then
        print("<b>Usage: find <pattern> [path] [@var]")
    else if not object then
        print(c.yellow + "<b>find: not holding remote object" + c.ennd)
    else
        path = "/"
        storeKey = null
        if inp.len >= 3 and inp[-1][0:1] == "@" then
            storeKey = inp[-1][1:]
            path = inp[2:-1].join(" ")
        else if inp.len >= 3 then
            path = inp[2]
        end if
        print(c.orange + "Finding '" + inp[1] + "' in " + path + " ..." + c.ennd)
        matches = []
        total = RFind(inp[1], path, object, matches)
        print(c.cyan + "find: " + total + " result(s)" + c.ennd)
        if total == 0 then
            globals.pipeFailed = true
        else
            joined = matches.join(",")
            globals.pipeResult = joined
            if storeKey != null then
                gco = get_custom_object
                if not gco.hasIndex("clips") then gco.clips = {}
                gco.clips[storeKey] = joined
                pipeVars[storeKey] = joined
                print(c.lime + "  @" + storeKey + " = " + joined + c.ennd)
            end if
        end if
    end if
end function
CommandTable["find"] = @CmdRfind

// -- SSH ----------------------------------------------------------
// Moved here from ops.src (which was pushing up against the 160,000
// char cap) — remote.src is the natural home for it anyway, being
// entirely about connecting to/acting on remote machines.
Ssh = function(creds, ip, port, comp)
    parts = creds.split("@")
    if parts.len < 2 then
        print(c.yellow + "<b>ssh: usage: ssh [user@pass] [ip] [opt:port]" + c.ennd)
        return
    end if
    user = parts[0]
    pass = parts[1]
    portInt = 22
    if port then portInt = port.to_int
    if typeof(portInt) != "number" then
        print(c.yellow + "<b>ssh: invalid port" + c.ennd)
        return
    end if
    print("Connecting to " + ip + ":" + portInt + " ...")
    shell = comp.connect_service(ip, portInt, user, pass, "ssh")
    if typeof(shell) == "string" then
        print(c.yellow + shell + c.ennd)
        return
    end if
    if shell then
        globals.object = shell
        globals.remotePath = "/"
        print(c.cyan + "<b>shell obtained: " + ip + c.ennd)
    else
        print(c.yellow + "<b>ssh: connection failed" + c.ennd)
    end if
end function

// ── SSH portals — saved logins for YOUR OWN machines ────────────────
// Persisted to /root/ai/pt/sshportals.txt (name|user|pass|ip|port per
// line), same pipe-delimited convention db.txt/deadlibs.txt already
// use. Hardcoded to phantom's canonical install path (same path
// import_code itself requires — see README) instead of currentPath,
// since currentPath wasn't reliably landing in pt for this. Lazily
// loaded into globals.sshPortals on first use instead of at phantom
// startup, so this stays self-contained.
SshPortalsPath = "/root/ai/pt/sshportals.txt"

// temporary debug prints — remove once the "doesn't survive a relaunch"
// issue is actually found; harmless either way since sshlist/sshsave
// already print plenty on their own
LoadSshPortals = function()
    globals.sshPortals = []
    f = myComp.File(SshPortalsPath)
    if not f then
        print(c.grey + "DEBUG: sshportals: no file at " + SshPortalsPath + c.ennd)
        return
    end if
    content = f.get_content
    print(c.grey + "DEBUG: sshportals: get_content returned type " + typeof(content) + c.ennd)
    if not content or content == "" then
        print(c.grey + "DEBUG: sshportals: file exists but content is empty/null" + c.ennd)
        return
    end if
    print(c.grey + "DEBUG: sshportals: read " + content.len + " byte(s) from " + SshPortalsPath + c.ennd)
    loaded = 0
    for line in content.split(char(10))
        if line == "" then continue
        line = line.replace(char(13), "")
        // confirmed: GreyScript's split("|") is unreliable even when
        // "|" genuinely appears in the string multiple times — a
        // well-formed 5-field line ("beans|root|Ickle1|1.2.3.4|22")
        // came back as 36 "fields" in testing, not 5. db.txt's own
        // loader has never used split("|") for exactly this reason —
        // it walks the line with indexOf("|", pos) + slicing instead,
        // which is what this now does too.
        p1 = line.indexOf("|")
        if p1 == null then
            print(c.grey + "DEBUG: sshportals: skipped malformed line (no |): " + line + c.ennd)
            continue
        end if
        p2 = line.indexOf("|", p1 + 1)
        p3 = null
        p4 = null
        if p2 != null then p3 = line.indexOf("|", p2 + 1)
        if p3 != null then p4 = line.indexOf("|", p3 + 1)
        if p2 == null or p3 == null or p4 == null then
            print(c.grey + "DEBUG: sshportals: skipped malformed line (not 4 |'s): " + line + c.ennd)
            continue
        end if
        name = line[:p1]
        user = line[p1+1:p2]
        pass = line[p2+1:p3]
        ip   = line[p3+1:p4]
        port = line[p4+1:]
        globals.sshPortals.push({"name": name, "user": user, "pass": pass, "ip": ip, "port": port})
        loaded = loaded + 1
    end for
    print(c.grey + "DEBUG: sshportals: loaded " + loaded + " portal(s)" + c.ennd)
end function

SaveSshPortals = function()
    out = ""
    for p in globals.sshPortals
        out = out + p["name"] + "|" + p["user"] + "|" + p["pass"] + "|" + p["ip"] + "|" + p["port"] + char(10)
    end for
    f = myComp.File(SshPortalsPath)
    if not f then
        myComp.touch("/root/ai/pt", "sshportals.txt")
        f = myComp.File(SshPortalsPath)
    end if
    if f and typeof(f) == "file" then
        wr = f.set_content(out)
        if typeof(wr) == "string" and wr != "" then
            print(c.yellow + "<b>sshsave: write error: " + wr + c.ennd)
        end if
    else
        print(c.yellow + "<b>sshsave: could not open " + SshPortalsPath + " for writing" + c.ennd)
    end if
end function

FindSshPortal = function(name)
    if not globals.hasIndex("sshPortals") then LoadSshPortals()
    for p in globals.sshPortals
        if p["name"] == name then return p
    end for
    return null
end function

// sshsave [name] [user@pass] [ip] [opt:port] — save your own login for
// quick reconnect later via "ssh [name]" instead of retyping creds
CmdSshSave = function(inp)
    if inp.len < 4 then
        print("<b>Usage: sshsave [name] [user@pass] [ip] [opt:port]")
        print(c.grey + "  saves your own login for quick reconnect — ssh [name] later instead of retyping" + c.ennd)
        return
    end if
    if not globals.hasIndex("sshPortals") then LoadSshPortals()
    name  = inp[1]
    creds = inp[2]
    ip    = inp[3]
    port  = "22"
    if inp.len >= 5 then port = inp[4]
    credParts = creds.split("@")
    if credParts.len < 2 then
        print(c.yellow + "<b>sshsave: creds must be user@pass" + c.ennd)
        return
    end if
    entry = {"name": name, "user": credParts[0], "pass": credParts[1], "ip": ip, "port": port}
    newList = []
    for p in globals.sshPortals
        if p["name"] != name then newList.push(p)
    end for
    newList.push(entry)
    globals.sshPortals = newList
    SaveSshPortals()
    print(c.green + "<b>sshsave: saved '" + name + "' -> " + ip + ":" + port + c.ennd)
end function
CommandTable["sshsave"] = @CmdSshSave

// sshlist — show every saved portal
CmdSshList = function(inp)
    if not globals.hasIndex("sshPortals") then LoadSshPortals()
    if globals.sshPortals.len == 0 then
        print(c.grey + "sshlist: no saved portals — use sshsave to add one" + c.ennd)
        return
    end if
    print(c.cyan + "<b>SSH PORTALS  (" + globals.sshPortals.len + ")" + c.ennd)
    for p in globals.sshPortals
        print(c.gold + "  " + p["name"] + c.ennd + c.grey + "  " + p["user"] + "@" + p["pass"] + "  " + p["ip"] + ":" + p["port"] + c.ennd)
    end for
end function
CommandTable["sshlist"] = @CmdSshList

// sshdel [name] — remove a saved portal
CmdSshDel = function(inp)
    if inp.len != 2 then
        print("<b>Usage: sshdel [name]")
        return
    end if
    if not globals.hasIndex("sshPortals") then LoadSshPortals()
    name = inp[1]
    found = false
    newList = []
    for p in globals.sshPortals
        if p["name"] == name then found = true else newList.push(p)
    end for
    globals.sshPortals = newList
    SaveSshPortals()
    if found then
        print(c.green + "<b>sshdel: removed '" + name + "'" + c.ennd)
    else
        print(c.yellow + "<b>sshdel: not found: " + name + c.ennd)
    end if
end function
CommandTable["sshdel"] = @CmdSshDel

// ssh [user@pass] [ip] [opt:port]  |  ssh [saved-name]
CmdSsh = function(inp)
    if inp.len == 2 and inp[1].indexOf("@") == null then
        portal = FindSshPortal(inp[1])
        if not portal then
            print(c.yellow + "<b>ssh: no saved portal named '" + inp[1] + "' — sshsave to add one, or use ssh [user@pass] [ip] [port]" + c.ennd)
            return
        end if
        Ssh(portal["user"] + "@" + portal["pass"], portal["ip"], portal["port"], myShell)
    else if inp.len == 3 then
        Ssh(inp[1], inp[2], null, myShell)
    else if inp.len == 4 then
        Ssh(inp[1], inp[2], inp[3], myShell)
    else
        print("<b>Usage: ssh [user@pass] [ip] [opt:port]  |  ssh [saved-name]")
    end if
end function
CommandTable["ssh"] = @CmdSsh
